# =============================================================================
# VideoBulin47 环境变量配置
# =============================================================================
# 本地开发：
#   1. 复制此文件为 .env.local
#   2. 填写下面的值
#   3. 执行 npm run dev
#
# Vercel 部署：
#   Project Settings > Environment Variables
#   把同名变量添加到 Production、Preview、Development 三个环境。
#
# 不要把 .env.local 或任何私钥提交到仓库。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 应用地址
# -----------------------------------------------------------------------------
# 用于 canonical、sitemap、OAuth 回跳、fal webhook 和 Waffo 支付完成后的返回地址。
# 本地：http://localhost:3000
# 生产：https://www.videobulin47.net
#   原因：www 是 Vercel 上的主域名，顶级域名 videobulin47.net 会 308 跳转到 www。
#   支付回跳、fal webhook、Waffo webhook 都必须用 www，否则 POST 请求会先吃到
#   一次 308 重定向，部分回调方不会跟随重定向，导致事件丢失。
NEXT_PUBLIC_APP_URL=https://www.videobulin47.net


# -----------------------------------------------------------------------------
# 2. Supabase
# -----------------------------------------------------------------------------
# 作用：登录认证、Postgres 数据库、RLS 权限、私有照片和视频存储。
#
# 获取位置：
#   Supabase Dashboard > Project Settings > API
#   - Project URL
#   - anon public key
#   - service_role secret key
#
# service_role key 会绕过 RLS，只能放在服务端。
# 不要把它放进任何 NEXT_PUBLIC_* 变量。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 3. Google 登录
# -----------------------------------------------------------------------------
# 作用：登录页的“Continue with Google”。
#
# 需要配置两个地方：
#
# A. Google Cloud Console
#    APIs & Services > Credentials > Create OAuth client ID > Web application
#
#    Authorized JavaScript origins：
#      http://localhost:3000
#      https://www.videobulin47.net
#
#    Authorized redirect URIs：
#      https://<你的-supabase-project-ref>.supabase.co/auth/v1/callback
#      http://127.0.0.1:54321/auth/v1/callback   （仅本地 Supabase CLI 需要）
#
# B. Supabase Dashboard
#    Authentication > Providers > Google
#    启用 Google，并把 Client ID 和 Client Secret 填进去。
#
# 下面两个值实际填写在 Supabase Dashboard，本应用不会直接读取。
# 放在这里只是提醒你不要遗漏。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 4. Supabase 邮件 / SMTP
# -----------------------------------------------------------------------------
# 作用：邮箱 Magic Link、注册确认、密码重置邮件。
#
# Supabase 自带邮件发送器有频率限制，不适合生产。
# 请配置自有 SMTP：
#   Supabase Dashboard > Project Settings > Authentication > SMTP
#
# 你需要向邮件服务商获取：
#   - SMTP host
#   - SMTP port
#   - SMTP username
#   - SMTP password
#   - 发件邮箱和发件人名称
#
# 这些值填写在 Supabase Dashboard，不要写进本应用的环境变量。


# -----------------------------------------------------------------------------
# 5. Waffo Pancake / 支付
# -----------------------------------------------------------------------------
# 作用：托管收银台、全球信用卡收款、税费处理、MoR 合规、退款和客户门户。
#
# 后台地址：
#   https://pancake.waffo.ai/dashboard
#
# WAFFO_MERCHANT_ID：
#   Dashboard > Settings > Developers
#
# WAFFO_PRIVATE_KEY：
#   Dashboard > Settings > Developers
#   按原始格式粘贴私钥。SDK 支持字面量 \n。
#
# WAFFO_PRODUCT_*：
#   Dashboard > Products
#   创建 3 个一次性产品：Single、Trio、Crew，并复制每个产品 ID（PROD_xxx）。
#   产品价格必须与 src/lib/constants.ts 里的公开价格一致。
#
# WAFFO_WEBHOOK_PUBLIC_KEY_*：
#   Dashboard > Settings > Webhooks
#   分别复制测试环境和生产环境的 webhook public key。
#
# Waffo 需要填写的 Webhook URL：
#   生产：https://www.videobulin47.net/api/webhooks/waffo
#   测试：https://你的-staging-域名/api/webhooks/waffo
#
# 至少订阅这些事件：
#   order.completed
#   refund.succeeded
#   refund.failed
#   subscription.* （以后启用订阅时再加）
#
# 成本保护里已经计入的 Waffo 费用：
#   每笔成功交易 3.9% + $0.50
#   每次退款 $1.00
#   触发 3DS 但失败的尝试 $0.30
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRODUCT_SINGLE=
WAFFO_PRODUCT_TRIO=
WAFFO_PRODUCT_CREW=
WAFFO_WEBHOOK_PUBLIC_KEY_TEST=
WAFFO_WEBHOOK_PUBLIC_KEY_PROD=


# -----------------------------------------------------------------------------
# 6. fal.ai / 视频生成
# -----------------------------------------------------------------------------
# 作用：通过异步队列和 webhook 调用 GPU 模型生成视频。
#
# 获取位置：
#   https://fal.ai/dashboard/keys
#   创建一个 API Key，填入 FAL_KEY。
#
# FAL_VIDEO_MODEL：
#   默认：fal-ai/kling-video/o3/standard/video-to-video/reference
#   Pro：fal-ai/kling-video/o3/pro/video-to-video/reference
#   备用：minimax/h3/reference-to-video
#
# 默认模型同时接收“参考视频 + 人物图”，更适合 Bulin 47 这种保留动作、
# 只替换人物的视频。普通图生视频模型无法稳定做到这一点。
#
# FAL_WEBHOOK_SECRET：
#   自己生成一个随机字符串。它会附加在 webhook URL 里，只有携带该密钥的
#   请求才能更新生成任务。
#
# 应用使用的 webhook URL：
#   https://www.videobulin47.net/api/webhooks/fal?job=<job>&token=<secret>
FAL_KEY=
FAL_WEBHOOK_SECRET=
FAL_VIDEO_MODEL=fal-ai/kling-video/o3/standard/video-to-video/reference


# -----------------------------------------------------------------------------
# 7. Bulin 47 模板素材
# -----------------------------------------------------------------------------
# 模型需要一个公开可访问的参考视频 URL。（音频可选，不填就用视频自带的原声。）
#
# 你必须提供：
#   - 有授权的 MP4 或 MOV 参考视频
#   - 有授权的音频文件，或参考视频自带的原始音频
#   - 模板中人物、音乐和画面的使用权
#
# 生产环境不要使用没有授权的艺人视频或音乐。
#
# 参考视频的硬性限制（换模板前先确认）：
#   MP4 或 MOV、3-15 秒、宽高都 >= 720px、23-60fps、<= 200MB。
#
# 多参考视频（可选，只对 MiniMax H3 生效）：
#   BULIN47_TEMPLATE_VIDEO_URL   = 主参考视频（Video 1），Kling 和 MiniMax 都用。
#   BULIN47_TEMPLATE_VIDEO_URLS  = 额外参考视频，逗号或换行分隔。
#
#   各模型对参考视频的数量限制（来自 fal 的 schema）：
#     - Kling O3 Reference / Pro：video_url 只接受 1 个视频，无法多参考。
#     - MiniMax H3：reference_video_urls 最多 3 个，每个 2-15 秒，合计 <= 15 秒。
#   所以这里最多放 2 个额外地址（主视频 + 2 = 3），多填的会被自动忽略。
#
# 推荐做法：把模板放在 Supabase 的公开桶 "templates" 里。
#   1. 执行 supabase/migrations/0002_public_template_bucket.sql 建桶，
#      或在 Dashboard > Storage 里手动建一个名为 templates 的公开桶。
#   2. 上传视频：npm run upload-template -- "D:\path\to\template.mp4"
#      脚本会打印公开地址，形如：
#      https://<project-ref>.supabase.co/storage/v1/object/public/templates/template.mp4
#   3. 把该地址填到 BULIN47_TEMPLATE_VIDEO_URL，并在 Vercel 重新部署。
#
# 不要把这些视频提交进 Git / public 目录：单次 Vercel 部署有体积上限，
# 每次部署都要重新打包这些大文件，仓库也会越来越重。
BULIN47_TEMPLATE_VIDEO_URL=
BULIN47_TEMPLATE_VIDEO_URLS=
BULIN47_TEMPLATE_AUDIO_URL=


# -----------------------------------------------------------------------------
# 8. Vercel 运维配置
# -----------------------------------------------------------------------------
# CRON_SECRET：
#   Vercel Project Settings > Environment Variables。
#   生成一个随机字符串。Vercel Cron 会以以下形式发送：
#     Authorization: Bearer <CRON_SECRET>
#
# ADMIN_EMAILS：
#   用逗号分隔的管理员邮箱，留给后续运营后台使用。
CRON_SECRET=
ADMIN_EMAILS=


# -----------------------------------------------------------------------------
# 9. 成本 / 毛利保护
# -----------------------------------------------------------------------------
# 代码会在提交生成任务前计算 credits，并检查 API 成本 + 支付费用是否低于
# 目标毛利。如果低于目标毛利，任务会被直接阻止。
#
# 当前参考成本：
#   Kling O3 Standard V2V：约 $0.126 / 秒
#   Kling O3 Pro V2V：约 $0.168 / 秒
#   MiniMax H3：2K 约 $0.13 / 秒
#
# 最低公开价格是 $9.99。Studio 包 $69.99 / 100 credits 是最差积分单价，
# 成本保护会按这个最差单价计算，避免低价包补贴高成本模型。
# 具体计算逻辑在 src/config/economics.ts。
